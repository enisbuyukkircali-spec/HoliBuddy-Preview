# Keep real values outside the checkout in /etc/holibuddy/holibuddy.env.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Enable only with a local reverse proxy replacing X-Forwarded-For with the peer IP.
TRUST_LOCAL_PROXY=true
ENUYGUN_API_USERNAME=
ENUYGUN_API_PASSWORD=
# Existing contact form uses an email draft until SMTP is configured and tested.
CONTACT_EMAIL_ENABLED=false
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
